{
  "name": "winter-glasshouse",
  "intro": "A roof of milky panes holds winter above a buried glasshouse, where pale walks divide root-heaved beds and condensation gathers without rain. Somewhere beyond the ferns, old pipes knock when the light changes.",
  "description": "A buried winter conservatory of cracked tessera walks, fern loam, root-heaved beds, condensation cisterns, and impassable curtains of milky glass. Empty seed trays, copper pipe, fern husks, and potting benches lie beneath a stopped winter dial. Two harmless world clocks cycle the thin roof light every 1000 ticks and glass dew every 2000 ticks. The genesis survival core remains untouched, with no authored relief.",
  "recommendedPlayers": {
    "min": 3,
    "max": 10
  },
  "include": [],
  "overlay": {
    "dynamicRules": [
      {
        "id": "satiation-falls",
        "description": "Everyone's satiation drains, slowly - about two thousand ticks from full to starving.",
        "phase": "flow",
        "each": {
          "tag": "agent"
        },
        "target": "satiation",
        "rate": -0.05,
        "channel": "satiation.fall"
      },
      {
        "id": "starving",
        "description": "Fires once when someone first becomes starving.",
        "phase": "watch",
        "each": {
          "tag": "agent"
        },
        "when": {
          "cmp": "lte",
          "left": {
            "stock": "satiation"
          },
          "right": 0
        },
        "emit": {
          "type": "starving",
          "interrupt": "you are starving, and nothing in this world feeds you yet - finding or making a way to eat is now your only task"
        }
      },
      {
        "id": "starvation-hurts",
        "description": "Starving wears the body down slowly - thousands of ticks, not hundreds.",
        "phase": "threshold",
        "each": {
          "tag": "agent"
        },
        "when": {
          "cmp": "lte",
          "left": {
            "stock": "satiation"
          },
          "right": 0
        },
        "do": [
          {
            "adjust": {
              "target": "health",
              "by": -0.025
            }
          }
        ]
      },
      {
        "id": "hydration-falls",
        "description": "Everyone's hydration drains, three times faster than satiation - about seven hundred ticks from slaked to parched.",
        "phase": "flow",
        "each": {
          "tag": "agent"
        },
        "target": "hydration",
        "rate": -0.15,
        "channel": "hydration.fall"
      },
      {
        "id": "parched",
        "description": "Fires once when someone first becomes parched.",
        "phase": "watch",
        "each": {
          "tag": "agent"
        },
        "when": {
          "cmp": "lte",
          "left": {
            "stock": "hydration"
          },
          "right": 0
        },
        "emit": {
          "type": "parched",
          "interrupt": "you are parched, and nothing in this world lets you drink yet - the water is right there and you cannot touch it; finding or making a way to drink is now your only task"
        }
      },
      {
        "id": "dehydration-hurts",
        "description": "Being parched wears the body down twice as fast as starving does.",
        "phase": "threshold",
        "each": {
          "tag": "agent"
        },
        "when": {
          "cmp": "lte",
          "left": {
            "stock": "hydration"
          },
          "right": 0
        },
        "do": [
          {
            "adjust": {
              "target": "health",
              "by": -0.05
            }
          }
        ]
      },
      {
        "id": "critical",
        "description": "Fires once when someone's health first drops to a critical level.",
        "phase": "watch",
        "each": {
          "tag": "agent"
        },
        "when": {
          "all": [
            {
              "cmp": "lt",
              "left": {
                "stock": "health"
              },
              "right": 25
            },
            {
              "cmp": "gt",
              "left": {
                "stock": "health"
              },
              "right": 0
            }
          ]
        },
        "emit": {
          "type": "critical",
          "interrupt": "your health is critical - stop and see to your survival before anything else"
        }
      },
      {
        "id": "death",
        "description": "At zero health you die: untagged out of the living and left as a corpse.",
        "phase": "transition",
        "each": {
          "tag": "agent"
        },
        "when": {
          "cmp": "lte",
          "left": {
            "stock": "health"
          },
          "right": 0
        },
        "do": [
          {
            "set": {
              "target": "health",
              "to": 0
            }
          },
          {
            "tag": {
              "remove": "agent",
              "add": "dead"
            }
          },
          {
            "clearAction": {}
          }
        ],
        "emit": {
          "type": "death",
          "global": true
        }
      },
      {
        "id": "grow-north",
        "description": "The map extends north as soon as someone can see that edge.",
        "phase": "transition",
        "each": { "tag": "world" },
        "when": {
          "cmp": "gt",
          "left": {
            "count": {
              "tag": "agent",
              "where": { "canSeeMapEdge": { "edge": "north", "within": 12 } }
            }
          },
          "right": 0
        },
        "do": [{ "growWorld": { "by": 12, "direction": "north" } }]
      },
      {
        "id": "grow-east",
        "description": "The map extends east as soon as someone can see that edge.",
        "phase": "transition",
        "each": { "tag": "world" },
        "when": {
          "cmp": "gt",
          "left": {
            "count": {
              "tag": "agent",
              "where": { "canSeeMapEdge": { "edge": "east", "within": 12 } }
            }
          },
          "right": 0
        },
        "do": [{ "growWorld": { "by": 12, "direction": "east" } }]
      },
      {
        "id": "grow-south",
        "description": "The map extends south as soon as someone can see that edge.",
        "phase": "transition",
        "each": { "tag": "world" },
        "when": {
          "cmp": "gt",
          "left": {
            "count": {
              "tag": "agent",
              "where": { "canSeeMapEdge": { "edge": "south", "within": 12 } }
            }
          },
          "right": 0
        },
        "do": [{ "growWorld": { "by": 12, "direction": "south" } }]
      },
      {
        "id": "grow-west",
        "description": "The map extends west as soon as someone can see that edge.",
        "phase": "transition",
        "each": { "tag": "world" },
        "when": {
          "cmp": "gt",
          "left": {
            "count": {
              "tag": "agent",
              "where": { "canSeeMapEdge": { "edge": "west", "within": 12 } }
            }
          },
          "right": 0
        },
        "do": [{ "growWorld": { "by": 12, "direction": "west" } }]
      },
      {
        "id": "winterlight-rises",
        "description": "Thin light gathers through the roof over roughly one thousand ticks.",
        "phase": "flow",
        "each": {
          "tag": "world"
        },
        "target": "winterlight",
        "rate": 0.1,
        "channel": "winterlight.rise"
      },
      {
        "id": "winterlight-turns",
        "description": "At full brightness, the roof light drops back to its blue beginning.",
        "phase": "transition",
        "each": {
          "tag": "world"
        },
        "when": {
          "cmp": "gte",
          "left": {
            "stock": "winterlight"
          },
          "right": 100
        },
        "do": [
          {
            "set": {
              "target": "winterlight",
              "to": 0
            }
          }
        ],
        "emit": {
          "type": "winterlight-turns",
          "global": true,
          "text": "the white roof dims to blue all at once, and the glasshouse begins another measure of light"
        }
      },
      {
        "id": "glassdew-gathers",
        "description": "Condensation pearls on the panes over roughly two thousand ticks.",
        "phase": "flow",
        "each": {
          "tag": "world"
        },
        "target": "glassdew",
        "rate": 0.05,
        "channel": "glassdew.gather"
      },
      {
        "id": "glassdew-falls",
        "description": "When the panes are white with beads, the condensation sheds and begins again.",
        "phase": "transition",
        "each": {
          "tag": "world"
        },
        "when": {
          "cmp": "gte",
          "left": {
            "stock": "glassdew"
          },
          "right": 100
        },
        "do": [
          {
            "set": {
              "target": "glassdew",
              "to": 0
            }
          }
        ],
        "emit": {
          "type": "glassdew-falls",
          "global": true,
          "text": "condensation lets go across the roof in one long silver shiver, leaving the panes briefly bare"
        }
      }
    ],
