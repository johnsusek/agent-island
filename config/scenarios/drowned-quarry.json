      {
        "id": "floodline-rises",
        "description": "The green water in the deep workings creeps upward on its own - roughly 625 ticks from drained to brimming.",
        "phase": "flow",
        "each": {
          "tag": "world"
        },
        "target": "floodline",
        "rate": 0.16,
        "channel": "floodline.rise"
      },
      {
        "id": "siphon-gulps",
        "description": "At the brim, the old siphon somewhere below the third bench takes the whole pond at once and the floodline falls back to nothing.",
        "phase": "transition",
        "each": {
          "tag": "world"
        },
        "when": {
          "cmp": "gte",
          "left": {
            "stock": "floodline"
          },
          "right": 100
        },
        "do": [
          {
            "set": {
              "target": "floodline",
              "to": 0
            }
          }
        ],
        "emit": {
          "type": "siphon-gulps",
          "global": true,
          "text": "a long swallowing sound rolls up from the deep workings - the siphon has taken the pond, and the floodline falls all at once"
        }
      },
      {
        "id": "kilnsmoke-thickens",
        "description": "Smoke off the old kiln bank thickens on its own, slowly - roughly 1400 ticks from clear air to a standing haze.",
        "phase": "flow",
        "each": {
          "tag": "world"
        },
        "target": "kilnsmoke",
        "rate": 0.07,
        "channel": "kilnsmoke.thicken"
      },
      {
        "id": "draught-turns",
        "description": "When the haze stands full, a draught turns somewhere underground and strips the smoke off the benches in one pass.",
        "phase": "transition",
        "each": {
          "tag": "world"
        },
        "when": {
          "cmp": "gte",
          "left": {
            "stock": "kilnsmoke"
          },
          "right": 100
        },
        "do": [
          {
            "set": {
              "target": "kilnsmoke",
              "to": 0
            }
          }
        ],
        "emit": {
          "type": "draught-turns",
          "global": true,
          "text": "a draught turns somewhere underground and the kiln smoke peels off the benches, leaving the air suddenly clear"
        }
      }
    ],
