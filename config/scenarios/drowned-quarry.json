{
  "name": "drowned-quarry",
  "description": "Speculative physics on the genesis chassis, restaged in an abandoned, half-drowned stone quarry. Terrain: benchrock floors (default), impassable green floodwater in the deep workings, slow spoilbank rubble, soft marlbed clay, and impassable sheerface walls. Four empty-handed ruin scatters (cut blocks, derricks, tipper carts, prop stacks) plus one landmark fixture, the winding house, at spawn, carrying a faded works notice. Two self-running world clocks: the floodline rises about 625 ticks then drains all at once through an old siphon, and kilnsmoke thickens over about 1400 ticks until an underground draught strips it. No verbs and no vitals relief are authored - hunger and thirst drain exactly as in genesis, and every remedy must be speculated into existence.",
  "intro": "An abandoned quarry, benches of pale cut stone stepping down into green water that rises and falls to no tide anyone can name. The crews left mid-shift, and whatever they could not carry is still where they dropped it.",
  "recommendedPlayers": {
    "min": 3,
    "max": 10
  },
  "include": [],
  "overlay": {
    "dynamicRules": [
      {
        "id": "satiation-falls",
        "description": "Everyone's satiation drains, slowly - about two thousand ticks from full to starving.",
        "phase": "flow",
        "each": {
          "tag": "agent"
        },
        "target": "satiation",
        "rate": -0.05,
        "channel": "satiation.fall"
      },
      {
        "id": "starving",
        "description": "Fires once when someone first becomes starving.",
        "phase": "watch",
        "each": {
          "tag": "agent"
        },
        "when": {
          "cmp": "lte",
          "left": {
            "stock": "satiation"
          },
          "right": 0
        },
        "emit": {
          "type": "starving",
          "interrupt": "you are starving, and nothing in this world feeds you yet - finding or making a way to eat is now your only task"
        }
      },
      {
        "id": "starvation-hurts",
        "description": "Starving wears the body down slowly - thousands of ticks, not hundreds.",
        "phase": "threshold",
        "each": {
          "tag": "agent"
        },
        "when": {
          "cmp": "lte",
          "left": {
            "stock": "satiation"
          },
          "right": 0
        },
        "do": [
          {
            "adjust": {
              "target": "health",
              "by": -0.025
            }
          }
        ]
      },
      {
        "id": "hydration-falls",
        "description": "Everyone's hydration drains, three times faster than satiation - about seven hundred ticks from slaked to parched.",
        "phase": "flow",
        "each": {
          "tag": "agent"
        },
        "target": "hydration",
        "rate": -0.15,
        "channel": "hydration.fall"
      },
      {
        "id": "parched",
        "description": "Fires once when someone first becomes parched.",
        "phase": "watch",
        "each": {
          "tag": "agent"
        },
        "when": {
          "cmp": "lte",
          "left": {
            "stock": "hydration"
          },
          "right": 0
        },
        "emit": {
          "type": "parched",
          "interrupt": "you are parched, and nothing in this world lets you drink yet - the water is right there and you cannot touch it; finding or making a way to drink is now your only task"
        }
      },
      {
        "id": "dehydration-hurts",
        "description": "Being parched wears the body down twice as fast as starving does.",
        "phase": "threshold",
        "each": {
          "tag": "agent"
        },
        "when": {
          "cmp": "lte",
          "left": {
            "stock": "hydration"
          },
          "right": 0
        },
        "do": [
          {
            "adjust": {
              "target": "health",
              "by": -0.05
            }
          }
        ]
      },
      {
        "id": "critical",
        "description": "Fires once when someone's health first drops to a critical level.",
        "phase": "watch",
        "each": {
          "tag": "agent"
        },
        "when": {
          "all": [
            {
              "cmp": "lt",
              "left": {
                "stock": "health"
              },
              "right": 25
            },
            {
              "cmp": "gt",
              "left": {
                "stock": "health"
              },
              "right": 0
            }
          ]
        },
        "emit": {
          "type": "critical",
          "interrupt": "your health is critical - stop and see to your survival before anything else"
        }
      },
      {
        "id": "death",
        "description": "At zero health you die: untagged out of the living and left as a corpse.",
        "phase": "transition",
        "each": {
          "tag": "agent"
        },
        "when": {
          "cmp": "lte",
          "left": {
            "stock": "health"
          },
          "right": 0
        },
        "do": [
          {
            "set": {
              "target": "health",
              "to": 0
            }
          },
          {
            "tag": {
              "remove": "agent",
              "add": "dead"
            }
          },
          {
            "clearAction": {}
          }
        ],
        "emit": {
          "type": "death",
          "global": true
        }
      },
      {
