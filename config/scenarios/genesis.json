{
  "name": "genesis",
  "description": "Speculative physics (docs/speculative-physics.md): a near-empty world of plains, water, and forest. No verbs beyond travel/speak/whisper/inscribe/give - characters attempt whatever they expect a world like this to support, and the Oracle turns repeated attempts into real rules. The one thing the world does on its own is make them thirsty and hungry, with no way to drink or eat yet: two clocks and a reason to petition. Thirst runs three times faster than hunger, and its remedy is visible - the lake is right there, untouchable - so it sets the order of the asking. Physics precipitates out of practice.",
  "recommendedPlayers": {
    "min": 3,
    "max": 10
  },
  "include": [],
  "overlay": {
    "dynamicRules": [
      {
        "id": "satiation-falls",
        "description": "Everyone's satiation drains, slowly - about two thousand ticks from full to starving.",
        "phase": "flow",
        "each": {
          "tag": "agent"
        },
        "target": "satiation",
        "rate": -0.05,
        "channel": "satiation.fall"
      },
      {
        "id": "starving",
        "description": "Fires once when someone first becomes starving.",
        "phase": "watch",
        "each": {
          "tag": "agent"
        },
        "when": {
          "cmp": "lte",
          "left": {
            "stock": "satiation"
          },
          "right": 0
        },
        "emit": {
          "type": "starving",
          "interrupt": "you are starving, and nothing in this world feeds you yet - finding or making a way to eat is now your only task"
        }
      },
      {
        "id": "starvation-hurts",
        "description": "Starving wears the body down slowly - thousands of ticks, not hundreds.",
        "phase": "threshold",
        "each": {
          "tag": "agent"
        },
        "when": {
          "cmp": "lte",
          "left": {
            "stock": "satiation"
          },
          "right": 0
        },
        "do": [
          {
            "adjust": {
              "target": "health",
              "by": -0.025
            }
          }
        ]
      },
      {
        "id": "hydration-falls",
        "description": "Everyone's hydration drains, three times faster than satiation - about seven hundred ticks from slaked to parched.",
        "phase": "flow",
        "each": {
          "tag": "agent"
        },
        "target": "hydration",
        "rate": -0.15,
        "channel": "hydration.fall"
      },
      {
        "id": "parched",
        "description": "Fires once when someone first becomes parched.",
        "phase": "watch",
        "each": {
          "tag": "agent"
        },
        "when": {
          "cmp": "lte",
          "left": {
            "stock": "hydration"
          },
          "right": 0
        },
        "emit": {
          "type": "parched",
          "interrupt": "you are parched, and nothing in this world lets you drink yet - the water is right there and you cannot touch it; finding or making a way to drink is now your only task"
        }
      },
      {
        "id": "dehydration-hurts",
        "description": "Being parched wears the body down twice as fast as starving does.",
        "phase": "threshold",
        "each": {
          "tag": "agent"
        },
        "when": {
          "cmp": "lte",
          "left": {
            "stock": "hydration"
          },
          "right": 0
        },
        "do": [
          {
            "adjust": {
              "target": "health",
              "by": -0.05
            }
          }
        ]
      },
      {
        "id": "critical",
        "description": "Fires once when someone's health first drops to a critical level.",
        "phase": "watch",
        "each": {
          "tag": "agent"
        },
        "when": {
          "all": [
            {
              "cmp": "lt",
              "left": {
                "stock": "health"
              },
              "right": 25
            },
            {
              "cmp": "gt",
              "left": {
                "stock": "health"
              },
              "right": 0
            }
          ]
        },
        "emit": {
          "type": "critical",
          "interrupt": "your health is critical - stop and see to your survival before anything else"
        }
      },
      {
        "id": "death",
        "description": "At zero health you die: untagged out of the living and left as a corpse.",
        "phase": "transition",
        "each": {
          "tag": "agent"
        },
        "when": {
          "cmp": "lte",
          "left": {
            "stock": "health"
          },
          "right": 0
        },
        "do": [
          {
            "set": {
              "target": "health",
              "to": 0
            }
          },
          {
            "tag": {
              "remove": "agent",
              "add": "dead"
            }
          },
          {
            "clearAction": {}
          }
        ],
        "emit": {
          "type": "death",
          "global": true
        }
      }
    ],
