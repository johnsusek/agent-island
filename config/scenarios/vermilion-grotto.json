{
  "name": "vermilion-grotto",
  "description": "Speculative physics on the genesis chassis, restaged as the Vermilion Grotto: a buried volcanic gallery of soot-black basalt, glowing mineral shelves, still blue pools, and sealed crystal seams. Four empty-handed material scatters invite interpretation; two harmless cavern clocks cycle without touching a body. Hunger and thirst remain unrelieved, and no actions are authored.",
  "recommendedPlayers": {
    "min": 3,
    "max": 10
  },
  "include": [],
  "overlay": {
    "dynamicRules": [
      {
        "id": "satiation-falls",
        "description": "Everyone's satiation drains, slowly - about two thousand ticks from full to starving.",
        "phase": "flow",
        "each": {
          "tag": "agent"
        },
        "target": "satiation",
        "rate": -0.05,
        "channel": "satiation.fall"
      },
      {
        "id": "starving",
        "description": "Fires once when someone first becomes starving.",
        "phase": "watch",
        "each": {
          "tag": "agent"
        },
        "when": {
          "cmp": "lte",
          "left": {
            "stock": "satiation"
          },
          "right": 0
        },
        "emit": {
          "type": "starving",
          "interrupt": "you are starving, and nothing in this world feeds you yet - finding or making a way to eat is now your only task"
        }
      },
      {
        "id": "starvation-hurts",
        "description": "Starving wears the body down slowly - thousands of ticks, not hundreds.",
        "phase": "threshold",
        "each": {
          "tag": "agent"
        },
        "when": {
          "cmp": "lte",
          "left": {
            "stock": "satiation"
          },
          "right": 0
        },
        "do": [
          {
            "adjust": {
              "target": "health",
              "by": -0.025
            }
          }
        ]
      },
      {
        "id": "hydration-falls",
        "description": "Everyone's hydration drains, three times faster than satiation - about seven hundred ticks from slaked to parched.",
        "phase": "flow",
        "each": {
          "tag": "agent"
        },
        "target": "hydration",
        "rate": -0.15,
        "channel": "hydration.fall"
      },
      {
        "id": "parched",
        "description": "Fires once when someone first becomes parched.",
        "phase": "watch",
        "each": {
          "tag": "agent"
        },
        "when": {
          "cmp": "lte",
          "left": {
            "stock": "hydration"
          },
          "right": 0
        },
        "emit": {
          "type": "parched",
          "interrupt": "you are parched, and nothing in this world lets you drink yet - the water is right there and you cannot touch it; finding or making a way to drink is now your only task"
        }
      },
      {
        "id": "dehydration-hurts",
        "description": "Being parched wears the body down twice as fast as starving does.",
        "phase": "threshold",
        "each": {
          "tag": "agent"
        },
        "when": {
          "cmp": "lte",
          "left": {
            "stock": "hydration"
          },
          "right": 0
        },
        "do": [
          {
            "adjust": {
              "target": "health",
              "by": -0.05
            }
          }
        ]
      },
      {
        "id": "critical",
        "description": "Fires once when someone's health first drops to a critical level.",
        "phase": "watch",
        "each": {
          "tag": "agent"
        },
        "when": {
          "all": [
            {
              "cmp": "lt",
              "left": {
                "stock": "health"
              },
              "right": 25
            },
            {
              "cmp": "gt",
              "left": {
                "stock": "health"
              },
              "right": 0
            }
          ]
        },
        "emit": {
          "type": "critical",
          "interrupt": "your health is critical - stop and see to your survival before anything else"
        }
      },
      {
        "id": "death",
        "description": "At zero health you die: untagged out of the living and left as a corpse.",
        "phase": "transition",
        "each": {
          "tag": "agent"
        },
        "when": {
          "cmp": "lte",
          "left": {
            "stock": "health"
          },
          "right": 0
        },
        "do": [
          {
            "set": {
              "target": "health",
              "to": 0
            }
          },
          {
            "tag": {
              "remove": "agent",
              "add": "dead"
            }
          },
          {
            "clearAction": {}
          }
        ],
        "emit": {
          "type": "death",
          "global": true
        }
      },
      {
        "id": "grow-north",
        "description": "The map extends north as soon as someone can see that edge.",
        "phase": "transition",
        "each": {
          "tag": "world"
        },
        "when": {
          "cmp": "gt",
          "left": {
            "count": {
              "tag": "agent",
              "where": {
                "canSeeMapEdge": {
                  "edge": "north",
                  "within": 12
