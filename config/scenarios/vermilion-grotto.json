      {
        "id": "cavern-glow-gathers",
        "description": "Mineral light gathers through the vaulted dark over roughly one thousand ticks.",
        "phase": "flow",
        "each": {
          "tag": "world"
        },
        "target": "cavern-glow",
        "rate": 0.1,
        "channel": "cavern-glow.gather"
      },
      {
        "id": "cavern-glow-turns",
        "description": "At full glow the veins go dark and begin their slow gathering again.",
        "phase": "transition",
        "each": {
          "tag": "world"
        },
        "when": {
          "cmp": "gte",
          "left": {
            "stock": "cavern-glow"
          },
          "right": 100
        },
        "do": [
          {
            "set": {
              "target": "cavern-glow",
              "to": 0
            }
          }
        ],
        "emit": {
          "type": "cavern-glow-turns",
          "global": true,
          "text": "the red veins wink out together, leaving the grotto to gather its glow again"
        }
      },
      {
        "id": "drip-chime-gathers",
        "description": "Water gathers in unseen bells over roughly two thousand ticks.",
        "phase": "flow",
        "each": {
          "tag": "world"
        },
        "target": "drip-chime",
        "rate": 0.05,
        "channel": "drip-chime.gather"
      },
      {
        "id": "drip-chime-falls",
        "description": "When the hidden basins brim, a long chime passes through the galleries and begins again.",
        "phase": "transition",
        "each": {
          "tag": "world"
        },
        "when": {
          "cmp": "gte",
          "left": {
            "stock": "drip-chime"
          },
          "right": 100
        },
        "do": [
          {
            "set": {
              "target": "drip-chime",
              "to": 0
            }
          }
        ],
        "emit": {
          "type": "drip-chime-falls",
          "global": true,
          "text": "a single clear drop rings somewhere beyond the walls, followed by a long answer from deeper stone"
        }
      }
    ],
