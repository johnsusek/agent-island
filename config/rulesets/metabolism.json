{
  "name": "metabolism",
  "description": "The hunger loop: hunger rises, starving warns, starvation wounds, and an unfed character dies. Bring `foraging` (or your own food source) to refill hunger.",
  "overlay": {
    "dynamicRules": [
      {
        "id": "hunger-rises",
        "description": "Every character grows hungrier each tick; eating is what holds it back.",
        "phase": "flow",
        "each": {
          "tag": "agent"
        },
        "target": "hunger",
        "rate": 0.1,
        "channel": "hunger.rise"
      },
      {
        "id": "starvation-hurts",
        "description": "When a character's hunger maxes out, their health starts draining.",
        "phase": "threshold",
        "each": {
          "tag": "agent"
        },
        "when": {
          "cmp": "gte",
          "left": {
            "stock": "hunger"
          },
          "right": 100
        },
        "do": [
          {
            "adjust": {
              "target": "health",
              "by": -1
            }
          }
        ]
      },
      {
        "id": "starving",
        "description": "Fires once when a character first becomes starving \u2014 the hunger alarm.",
        "phase": "watch",
        "each": {
          "tag": "agent"
        },
        "when": {
          "cmp": "gte",
          "left": {
            "stock": "hunger"
          },
          "right": 100
        },
        "emit": {
          "type": "starving",
          "interrupt": "you are starving - eat from your pack now, or make getting food your only task"
        }
      },
      {
        "id": "critical",
        "description": "Fires once when a character's health first drops to a critical level \u2014 the last-chance warning.",
        "phase": "watch",
        "each": {
          "tag": "agent"
        },
        "when": {
          "all": [
            {
              "cmp": "lt",
              "left": {
                "stock": "health"
              },
              "right": 25
            },
            {
              "cmp": "gt",
              "left": {
                "stock": "health"
              },
              "right": 0
            }
          ]
        },
        "emit": {
          "type": "critical",
          "interrupt": "your health is critical - stop and see to your survival before anything else"
        }
      },
      {
        "id": "death",
        "description": "When a character's health hits zero they die: untagged out of the living and left as a corpse.",
        "phase": "transition",
        "each": {
          "tag": "agent"
        },
        "when": {
          "cmp": "lte",
          "left": {
            "stock": "health"
          },
          "right": 0
        },
        "do": [
          {
            "set": {
              "target": "health",
              "to": 0
            }
          },
          {
            "tag": {
              "remove": "agent",
              "add": "dead"
            }
          },
          {
            "clearAction": {}
          }
        ],
        "emit": {
          "type": "died"
        }
      },
      {
        "id": "eat",
        "kind": "action",
        "duration": 2,
        "description": "Eat food from your own pack to ease your hunger, gathered from a source or taken from a stockpile.",
        "params": [],
        "requires": {
          "cmp": "gte",
          "left": {
            "stock": "food"
          },
          "right": 1
        },
        "requireReason": "must be carrying food to eat",
        "do": [
          {
            "adjust": {
              "target": "food",
              "by": -1
            }
          },
          {
            "adjust": {
              "target": "hunger",
              "by": -40
            }
          }
        ],
        "emit": {
          "type": "ate"
        }
      }
    ],
    "removedBaseIds": [],
    "stockDefaults": {
      "health": {
        "value": 100,
        "icon": "health",
        "color": "#e56b6f"
      },
      "hunger": {
        "value": 0,
        "icon": "food",
        "color": "#e0453f"
      },
      "food": {
        "value": 0,
        "max": 12,
        "icon": "food",
        "color": "#e0453f",
        "stockpilable": true
      }
    },
    "describeEvent": {
      "ate": "{{ ctx.name }} eats from their pack (hunger {{ ctx.stocks.hunger.value }}).",
      "starving": "{{ ctx.name }} is starving.",
      "critical": "{{ ctx.name }} is in critical condition (health {{ ctx.stocks.health.value }}).",
      "died": "{{ ctx.name }} has died."
    },
    "kindVisuals": {
      "agent": {
        "sprite": {
          "size": [16, 32],
          "kind": "token",
          "mirror": "horizontal",
          "palette": {
            ".": "none",
            "k": "#2e222f",
            "s": "#ab947a",
            "S": "#966c6c",
            "h": "#4c3e24",
            "t": "#4d65b4",
            "T": "#323353",
            "r": "#694f62",
            "b": "#3e3546"
          },
          "grid": [
            "........",
            "........",
            "........",
            "......kk",
            "....khhh",
            "....khhh",
            "....khhh",
            "....khhh",
            "....ksks",
            "....ksss",
            ".....kSs",
            "......SS",
            "...ktttt",
            "...kTttt",
            "...kTttt",
            "...kTttt",
            "...kTttt",
            "...kTttt",
            "...kTttt",
            "...ksttt",
            "...ktttt",
            "....krrr",
            "....krrk",
            "....krrk",
            "....krrk",
            "....krrk",
            "....krrk",
            "....krrk",
            "....kbbk",
            "....kbbk",
            "....kbbk",
            "....kbbk"
          ]
        }
      },
      "dead": {
        "sprite": {
          "size": [16, 16],
          "kind": "token",
          "palette": {
            ".": "none",
            "k": "#2e222f",
            "b": "#9babb2",
            "w": "#c7dcd0"
          },
          "grid": [
            "................",
            "................",
            "................",
            ".............kwk",
            "............kwk.",
            "...........kwk..",
            "....kbbbk.kwk...",
            "...kbwwwbbk.....",
            "...kbwbbbbk.....",
            "...kbkbbkbk.....",
            "...kbbkkbbk.....",
            "...kbwbbbbk.....",
            "....kwbwbk......",
            "................",
            ".kwk......kwk...",
            ".kwkbbbbbbkwk..."
          ],
          "mirror": "none"
        },
        "icon": "dead",
        "color": "#9a8f7a",
        "label": "remains"
      }
    }
  }
}
