      },
      "satiation": {
        "value": 100,
        "min": 0,
        "max": 100,
        "role": "vital",
        "label": "satiation",
        "bands": {
          "pressing": "You are getting hungry.",
          "serious": "You are very hungry - eat a fish soon.",
          "critical": "You are starving. Eat now."
        },
        "icon": "food",
        "color": "#e0453f"
      },
      "warmth": {
        "value": 100,
        "min": 0,
        "max": 100,
        "role": "vital",
        "label": "warmth",
        "bands": {
          "pressing": "You are getting cold.",
          "serious": "You are very cold - burn some firewood soon.",
          "critical": "You are freezing. Burn firewood now."
        },
        "icon": "campfire",
        "color": "#e08a3f"
      },
      "hydration": {
        "value": 100,
        "min": 0,
        "max": 100,
        "role": "vital",
        "label": "hydration",
        "bands": {
          "pressing": "You are getting thirsty.",
          "serious": "You are very thirsty - drink soon.",
          "critical": "You are dying of thirst. Drink now."
        },
        "icon": "water-drop",
        "color": "#3f8ee0"
      },
      "fish": {
        "value": 2,
        "min": 0,
        "max": 10,
        "icon": "fish-bucket",
        "color": "#6aa0c8",
        "role": "pack",
        "label": "fish"
      },
      "firewood": {
        "value": 2,
        "min": 0,
        "max": 10,
        "icon": "wood-pile",
        "color": "#9a6b3f",
        "role": "pack",
        "label": "firewood"
      },
      "water": {
        "value": 2,
        "min": 0,
        "max": 10,
        "icon": "water-flask",
        "color": "#3f8ee0",
        "role": "pack",
        "label": "water"
      }
    },
    "fixtures": [
      {
        "id": "rod-1",
        "kind": "rod",
        "tags": ["portable", "tool"],
        "atSpawn": true
      },
      {
        "id": "rod-2",
        "kind": "rod",
        "tags": ["portable", "tool"],
        "atSpawn": true
      },
      {
        "id": "axe-1",
        "kind": "axe",
        "tags": ["portable", "tool"],
        "atSpawn": true
      },
      {
        "id": "axe-2",
        "kind": "axe",
        "tags": ["portable", "tool"],
        "atSpawn": true
      },
      {
        "id": "bucket-1",
        "kind": "bucket",
        "tags": ["portable", "tool"],
        "atSpawn": true
      },
      {
        "id": "bucket-2",
        "kind": "bucket",
        "tags": ["portable", "tool"],
        "atSpawn": true
      }
