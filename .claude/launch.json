{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "agent-island-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "port": 5173
    },
    {
      "name": "agent-island-scratch",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
