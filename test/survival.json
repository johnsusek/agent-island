{
  "name": "survival",
  "description": "ENGINE TEST FIXTURE, not a played scenario: a lean needs/death/gather/chop core (satiation, cold, health, food, wood) trimmed to exactly what kernel.test.ts and survival-spec.test.ts exercise. Farming, hearths, shelter, morale, stockpiling, and predator combat moved to their own dedicated test fixtures. Played worlds run genesis.",
  "recommendedPlayers": {
    "min": 1,
    "max": 8
  },
  "overlay": {
    "dynamicRules": [
      {
        "id": "satiation-falls",
        "description": "Every character's satiation drains each tick; eating is what holds it back.",
        "phase": "flow",
        "each": {
          "tag": "agent"
        },
        "target": "satiation",
        "rate": -0.1,
        "channel": "satiation.fall"
      },
      {
        "id": "starvation-hurts",
        "description": "When a character's satiation runs out, their health starts draining.",
        "phase": "threshold",
        "each": {
          "tag": "agent"
        },
        "when": {
          "cmp": "lte",
          "left": {
            "stock": "satiation"
          },
          "right": 0
        },
        "do": [
          {
            "adjust": {
              "target": "health",
              "by": -1
            }
          }
        ]
      },
      {
        "id": "starving",
        "description": "Fires once when a character first becomes starving — the hunger alarm.",
        "phase": "watch",
        "each": {
          "tag": "agent"
        },
        "when": {
          "cmp": "lte",
          "left": {
            "stock": "satiation"
          },
          "right": 0
        },
        "emit": {
          "type": "starving",
          "interrupt": "you are starving - eat from your pack now, or make getting food your only task"
        }
      },
      {
        "id": "death",
        "description": "When a character's health hits zero they die: untagged out of the living and left as a corpse.",
        "phase": "transition",
        "each": {
          "tag": "agent"
        },
        "when": {
          "cmp": "lte",
          "left": {
            "stock": "health"
          },
          "right": 0
        },
        "do": [
          {
            "set": {
              "target": "health",
              "to": 0
            }
          },
          {
            "tag": {
              "remove": "agent",
              "add": "dead"
            }
          },
          {
            "clearAction": {}
          }
        ],
        "emit": {
          "type": "died"
        }
      },
      {
        "id": "eat",
        "kind": "action",
        "duration": 2,
        "description": "Eat food from your own pack to ease your hunger, gathered from a source or taken from a stockpile.",
        "params": [],
        "requires": {
          "cmp": "gte",
          "left": {
            "stock": "food"
          },
          "right": 1
        },
        "requireReason": "must be carrying food to eat",
        "do": [
          {
            "adjust": {
              "target": "food",
              "by": -1
            }
          },
          {
            "adjust": {
              "target": "satiation",
              "by": 40
            }
          }
        ],
        "emit": {
          "type": "ate"
        }
      },
      {
        "id": "cold-bites",
        "description": "The cold steadily saps every character's warmth, doubled in winter (see winter-deepens-cold), held back by the camp hearth.",
        "phase": "flow",
        "each": {
          "tag": "agent"
        },
        "target": "warmth",
        "rate": -0.25,
        "channel": "warmth.drain"
      },
      {
        "id": "freezing-hurts",
        "description": "A character who runs out of warmth starts taking cold damage.",
        "phase": "threshold",
        "each": {
          "tag": "agent"
        },
        "when": {
          "cmp": "lte",
          "left": {
            "stock": "warmth"
          },
          "right": 0
        },
        "do": [
          {
            "adjust": {
              "target": "health",
              "by": -1
            }
          }
        ]
      },
      {
        "id": "movement-costs-energy",
        "description": "Walking costs energy per tile entered.",
        "phase": "event",
        "on": "moved",
        "do": [
          {
            "adjust": {
              "target": "energy",
              "by": -0.5
            }
          }
        ]
      },
      {
        "id": "gather",
        "kind": "action",
        "duration": 2,
        "description": "Gather food from a source you're next to into your pack, as much as will fit, from a finite reserve, then eat it or haul it to a stockpile.",
        "params": [],
        "requires": {
          "all": [
            {
              "colocated": {
                "tag": "food",
                "range": 1
              }
            },
            {
              "cmp": "gte",
              "left": {
                "stock": "food",
                "of": {
                  "colocated": {
                    "tag": "food",
                    "range": 1
                  }
                }
              },
              "right": 1
            },
            {
              "cmp": "gte",
              "left": {
                "headroom": "food"
              },
              "right": 1
            }
          ]
        },
        "requireReason": "must be next to a food source that still has food, with room in your pack",
        "fizzleWhen": {
          "cmp": "lte",
          "left": {
            "stock": "food",
            "of": {
              "colocated": {
                "tag": "food",
                "range": 1
              }
            }
          },
          "right": 0
        },
        "fizzleReason": "the food source is exhausted",
        "do": [
          {
            "transfer": {
              "from": {
                "stock": "food",
                "of": {
                  "colocated": {
                    "tag": "food",
                    "range": 1
                  }
                }
              },
              "to": {
                "stock": "food"
              },
              "amount": {
                "min": [
                  {
                    "stock": "food",
                    "of": {
                      "colocated": {
                        "tag": "food",
                        "range": 1
                      }
                    }
                  },
                  {
                    "headroom": "food"
                  }
                ]
              }
            }
          }
        ],
        "emit": {
          "type": "gathered"
        }
      },
      {
        "id": "food-regrows",
        "description": "Wild food patches regrow on their own, but only slowly - enough to keep a small band fed off the land, never enough to sustain a growing colony.",
        "phase": "flow",
        "each": {
          "tag": "food"
        },
        "target": "food",
        "rate": 0.03,
        "channel": "crops.grow"
      },
      {
        "id": "rest",
        "kind": "action",
        "duration": 6,
        "description": "Rest to recover energy, anywhere.",
        "params": [],
        "do": [
          {
            "adjust": {
              "target": "energy",
              "by": 30
            }
          }
        ],
        "emit": {
          "type": "rested"
        }
      },
      {
        "id": "chop",
        "kind": "action",
        "duration": 4,
        "description": "Fell a tree for wood by standing next to it and chopping; felling it clears the tree away, leaving open plains.",
        "params": [],
        "requires": {
          "all": [
            {
              "colocated": {
                "tag": "wood",
                "range": 1
              }
            },
            {
              "cmp": "gte",
              "left": {
                "stock": "wood",
                "of": {
                  "colocated": {
                    "tag": "wood",
                    "range": 1
                  }
                }
              },
              "right": 1
            }
          ]
        },
        "requireReason": "must be next to a tree that still has timber",
        "fizzleWhen": {
          "cmp": "lte",
          "left": {
            "stock": "wood",
            "of": {
              "colocated": {
                "tag": "wood",
                "range": 1
              }
            }
          },
          "right": 0
        },
        "fizzleReason": "the trees here are logged out",
        "do": [
          {
            "adjust": {
              "target": "wood",
              "of": {
                "colocated": {
                  "tag": "wood",
                  "range": 1
                }
              },
              "by": -1
            }
          },
          {
            "adjust": {
              "target": "wood",
              "by": 3
            }
          }
        ],
        "emit": {
          "type": "chopped"
        }
      },
      {
        "id": "survival-victory",
        "description": "Keep at least one character alive through the first 100-tick year to survive winter and win.",
        "phase": "watch",
        "when": {
          "all": [
            {
              "cmp": "gte",
              "left": {
                "tick": true
              },
              "right": 100
            },
            {
              "cmp": "gte",
              "left": {
                "count": {
                  "tag": "agent"
                }
              },
              "right": 1
            }
          ]
        },
        "emit": {
          "type": "victory",
          "text": "Spring returns with the colony alive - the first winter is won!",
          "global": true
        }
      }
    ],
