{
  "name": "@agent-island/core",
  "version": "0.1.0",
  "private": true,
  "description": "A deterministic, data-driven rules engine for agent simulations: entities with numeric stocks, JSON rules evaluated in fixed tick phases, and dry runs for rules authored at runtime.",
  "type": "module",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./kernel": {
      "source": "./src/kernel.ts",
      "types": "./dist/kernel.d.ts",
      "default": "./dist/kernel.js"
    },
    "./space": {
      "source": "./src/space.ts",
      "types": "./dist/space.d.ts",
      "default": "./dist/space.js"
    },
    "./rule-schema": {
      "source": "./src/rule-schema.ts",
      "types": "./dist/rule-schema.d.ts",
      "default": "./dist/rule-schema.js"
    },
    "./dryrun": {
      "source": "./src/dryrun.ts",
      "types": "./dist/dryrun.d.ts",
      "default": "./dist/dryrun.js"
    },
    "./stock-display": {
      "source": "./src/stock-display.ts",
      "types": "./dist/stock-display.d.ts",
      "default": "./dist/stock-display.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "node --conditions=source --import tsx --test test/*.test.ts",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
