{
  "name": "@agent-island/engine",
  "version": "0.1.0",
  "private": true,
  "description": "A world host for the rules core: agents on a grid, actions and standing orders, speech, events, runtime rule edits, scenarios as overlays, and snapshots.",
  "type": "module",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./engine": {
      "source": "./src/engine.ts",
      "types": "./dist/engine.d.ts",
      "default": "./dist/engine.js"
    },
    "./engine-actions": {
      "source": "./src/engine-actions.ts",
      "types": "./dist/engine-actions.d.ts",
      "default": "./dist/engine-actions.js"
    },
    "./engine-orders": {
      "source": "./src/engine-orders.ts",
      "types": "./dist/engine-orders.d.ts",
      "default": "./dist/engine-orders.js"
    },
    "./orders": {
      "source": "./src/orders.ts",
      "types": "./dist/orders.d.ts",
      "default": "./dist/orders.js"
    },
    "./overlays": {
      "source": "./src/overlays.ts",
      "types": "./dist/overlays.d.ts",
      "default": "./dist/overlays.js"
    },
    "./scenario": {
      "source": "./src/scenario.ts",
      "types": "./dist/scenario.d.ts",
      "default": "./dist/scenario.js"
    },
    "./sprite": {
      "source": "./src/sprite.ts",
      "types": "./dist/sprite.d.ts",
      "default": "./dist/sprite.js"
    },
    "./vitals": {
      "source": "./src/vitals.ts",
      "types": "./dist/vitals.d.ts",
      "default": "./dist/vitals.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "node --conditions=source --import tsx --test test/*.test.ts",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@agent-island/core": "0.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
