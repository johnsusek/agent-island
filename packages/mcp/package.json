{
  "name": "@agent-island/mcp",
  "version": "0.1.0",
  "private": true,
  "description": "An MCP host for agent simulations: a colony coordinator (sessions, the turn barrier or real-time clock, victory, an event journal, optional file persistence) and two Streamable HTTP MCP surfaces, one for characters and one for game masters who edit the rules at runtime.",
  "type": "module",
  "bin": {
    "agent-island-mcp": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./briefing": {
      "source": "./src/briefing.ts",
      "types": "./dist/briefing.d.ts",
      "default": "./dist/briefing.js"
    },
    "./coordinator": {
      "source": "./src/coordinator.ts",
      "types": "./dist/coordinator.d.ts",
      "default": "./dist/coordinator.js"
    },
    "./coordinator-admin": {
      "source": "./src/coordinator-admin.ts",
      "types": "./dist/coordinator-admin.d.ts",
      "default": "./dist/coordinator-admin.js"
    },
    "./coordinator-gm": {
      "source": "./src/coordinator-gm.ts",
      "types": "./dist/coordinator-gm.d.ts",
      "default": "./dist/coordinator-gm.js"
    },
    "./coordinator-inspection": {
      "source": "./src/coordinator-inspection.ts",
      "types": "./dist/coordinator-inspection.d.ts",
      "default": "./dist/coordinator-inspection.js"
    },
    "./coordinator-scenarios": {
      "source": "./src/coordinator-scenarios.ts",
      "types": "./dist/coordinator-scenarios.d.ts",
      "default": "./dist/coordinator-scenarios.js"
    },
    "./journal": {
      "source": "./src/journal.ts",
      "types": "./dist/journal.d.ts",
      "default": "./dist/journal.js"
    },
    "./mcp-handler": {
      "source": "./src/mcp-handler.ts",
      "types": "./dist/mcp-handler.d.ts",
      "default": "./dist/mcp-handler.js"
    },
    "./mcp-order-schema": {
      "source": "./src/mcp-order-schema.ts",
      "types": "./dist/mcp-order-schema.d.ts",
      "default": "./dist/mcp-order-schema.js"
    },
    "./scenarios": {
      "source": "./src/scenarios.ts",
      "types": "./dist/scenarios.d.ts",
      "default": "./dist/scenarios.js"
    },
    "./sense-prose": {
      "source": "./src/sense-prose.ts",
      "types": "./dist/sense-prose.d.ts",
      "default": "./dist/sense-prose.js"
    },
    "./serve": {
      "source": "./src/serve.ts",
      "types": "./dist/serve.d.ts",
      "default": "./dist/serve.js"
    },
    "./world-file": {
      "source": "./src/world-file.ts",
      "types": "./dist/world-file.d.ts",
      "default": "./dist/world-file.js"
    }
  },
  "files": [
    "dist",
    "examples",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node -e \"const fs=require('fs');for(const f of ['briefing.md','gm-briefing.md','mcp-tool-descriptions'])fs.cpSync('src/'+f,'dist/'+f,{recursive:true})\"",
    "test": "node --conditions=source --import tsx --test test/*.test.ts",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@agent-island/core": "0.1.0",
    "@agent-island/engine": "0.1.0",
    "@modelcontextprotocol/sdk": "1.29.0",
    "@types/express": "^5.0.0",
    "express": "^5.1.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
